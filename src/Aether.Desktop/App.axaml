<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aether.Desktop.App">
  <!-- FluentTheme 为基线（原生控件）；工作台设计 token/chrome 样式由 WorkbenchWindow 自带资源叠加 -->
  <Application.Styles>
    <FluentTheme />
  </Application.Styles>
</Application>
