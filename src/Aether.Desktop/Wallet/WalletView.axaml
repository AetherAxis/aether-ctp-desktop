<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aether.Desktop.Wallet.WalletView">
  <!-- M2（规划中）：① LedgerClient + 充值/提币（对接 ⑧ doc/funding-runbook.md 的日常操作面） -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
    <TextBlock Text="钱包" FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
    <TextBlock Text="M2——① Aether.Ledger（AQ 充值/提币）接线规划中"
               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
  </StackPanel>
</UserControl>
