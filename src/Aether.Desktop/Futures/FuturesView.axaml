<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aether.Desktop.Futures.FuturesView">

  <UserControl.Styles>
    <Style Selector="Button.chip">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="4" />
      <Setter Property="Padding" Value="10,4" />
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="Button.chip:pointerover /template/ ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource AccentTintBgBrush}" />
    </Style>
    <Style Selector="TextBox.mini">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Height" Value="24" />
    </Style>
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,Auto,Auto,*" Background="{DynamicResource ContentBgBrush}">

    <!-- ═══ 登录主行：预设 + 交易前置 + 用户号 + 密码 + 连接/断开（原「连接器」tab 收编而来） ═══ -->
    <Border Grid.Row="0" Padding="12,7" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,170,Auto,110,Auto,90,Auto,90,Auto,Auto,*">
        <TextBlock Grid.Column="0" Text="预设" FontSize="12" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <ItemsControl Grid.Column="1" ItemsSource="{Binding Connector.Presets}" Margin="6,0,0,0">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Button Classes="chip"
                      Content="{Binding Name}"
                      Command="{Binding $parent[UserControl].DataContext.Connector.ApplyPresetCommand}"
                      CommandParameter="{Binding}"
                      ToolTip.Tip="填入登录表单（预设名 = {交易前置, 行情前置}；行情订阅归行情页）"/>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <TextBlock Grid.Column="2" Text="交易前置" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Grid.Column="3" Text="{Binding Connector.Front}" FontSize="12" Height="28" Margin="6,0,0,0"
                 PlaceholderText="tcp://127.0.0.1:17801"/>

        <TextBlock Grid.Column="4" Text="用户号" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Grid.Column="5" Text="{Binding Connector.UserId}" FontSize="12" Height="28" Margin="6,0,0,0"/>

        <TextBlock Grid.Column="6" Text="密码" FontSize="12" VerticalAlignment="Center" Margin="12,0,0,0"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Grid.Column="7" Text="{Binding Connector.Password}" PasswordChar="•" FontSize="12" Height="28"
                 Margin="6,0,0,0" ToolTip.Tip="不落盘——每次启动现输（恢复「记住密码」须接系统钥匙串）"/>

        <Button Grid.Column="8" Content="连接" Classes="primary" Margin="12,0,0,0" Padding="14,4" FontSize="12"
                Command="{Binding Connector.ToggleConnectionCommand}"
                IsVisible="{Binding !Connector.IsConnected}" IsEnabled="{Binding !Connector.IsConnecting}"/>
        <Button Grid.Column="8" Content="断开" Margin="12,0,0,0" Padding="14,4" FontSize="12"
                Command="{Binding Connector.ToggleConnectionCommand}"
                IsVisible="{Binding Connector.IsConnected}"/>
        <StackPanel Grid.Column="9" Orientation="Horizontal" Spacing="6" Margin="12,0,0,0" VerticalAlignment="Center">
          <Panel Width="10" Height="10">
            <Ellipse Width="10" Height="10" Fill="#4CAF50" IsVisible="{Binding Connector.IsConnected}"/>
            <Ellipse Width="10" Height="10" Fill="#9E9E9E" IsVisible="{Binding !Connector.IsConnected}"/>
          </Panel>
          <TextBlock Text="{Binding Connector.StatusText}" FontSize="12" FontWeight="SemiBold"
                     TextTrimming="CharacterEllipsis"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- ═══ 登录次行（高级字段——预设会带；手动改柜台时才碰） ═══ -->
    <Border Grid.Row="1" Padding="12,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
            Background="{DynamicResource CardBgBrush}">
      <StackPanel Orientation="Horizontal" Spacing="10">
        <TextBlock Text="经纪商" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Classes="mini" Width="60" Text="{Binding Connector.Broker}"/>
        <TextBlock Text="行情前置" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Classes="mini" Width="180" Text="{Binding Connector.MdFront}"
                 ToolTip.Tip="登录档案的一部分（⑦ 重连用）；实际订阅行情在行情页"/>
        <TextBlock Text="AppId" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Classes="mini" Width="150" Text="{Binding Connector.AppId}"/>
        <TextBlock Text="授权码" FontSize="11" VerticalAlignment="Center"
                   Foreground="{DynamicResource TextSecondaryBrush}"/>
        <TextBox Classes="mini" Width="120" Text="{Binding Connector.AuthCode}"/>
        <CheckBox Content="自动连接" FontSize="11" IsChecked="{Binding Connector.AutoLogin}"
                  ToolTip.Tip="密码不落盘 ⇒ 冷启动仍需现输一次密码"/>
      </StackPanel>
    </Border>

    <!-- ═══ 账户摘要条：连接状态 + 账户/权益/可用 + 刷新 ═══ -->
    <Border Grid.Row="2" Padding="10,6" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
      <StackPanel Orientation="Horizontal" Spacing="24">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="状态" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding ConnectionState}" FontSize="12" VerticalAlignment="Center"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="账户" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding AccountIdText}" FontSize="13" FontWeight="SemiBold"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="权益" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding BalanceText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <TextBlock Text="可用" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"/>
          <TextBlock Text="{Binding AvailableText}" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6">
          <Button Content="刷新" Command="{Binding RefreshCommand}" FontSize="12" Padding="8,3"/>
        </StackPanel>
        <TextBlock Text="{Binding StatusText}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"
                   VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
    </Border>

    <!-- ═══ 主区：持仓（上，全宽） + 委托（下，手动刷新）——行情板已移除（看行情归行情页） ═══ -->
    <Grid Grid.Row="3" RowDefinitions="*,Auto,240">

      <!-- ── 持仓 ── -->
      <Grid Grid.Row="0" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="10,6" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="130,70,80,110,110,110,120,*">
            <TextBlock Grid.Column="0" Text="持仓·合约" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="方向" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="总仓" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="持仓成本" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="现价" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="浮动盈亏" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="今/昨" FontSize="12" FontWeight="SemiBold"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Positions}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="130,70,80,110,110,110,120,*">
                    <TextBlock Grid.Column="0" Text="{Binding Instrument}" FontSize="13" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="1" Text="{Binding Direction}" FontSize="13"/>
                    <TextBlock Grid.Column="2" Text="{Binding Total}" FontSize="13"/>
                    <TextBlock Grid.Column="3" Text="{Binding PositionCost, StringFormat=F2}" FontSize="13"/>
                    <TextBlock Grid.Column="4" Text="{Binding CurrentPrice, StringFormat=F2}" FontSize="13"/>
                    <TextBlock Grid.Column="5" Text="{Binding Profit, StringFormat=F2}" FontSize="13"
                               Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Grid.Column="6" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}">
                      <Run Text="{Binding Today}"/>/<Run Text="{Binding Yesterday}"/>
                    </TextBlock>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>

      <GridSplitter Grid.Row="1" Classes="split-h" Height="6" ResizeDirection="Rows"/>

      <!-- ── 委托（手动刷新：空表查询 30s 超时为已知边界） ── -->
      <Grid Grid.Row="2" RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="10,4,10,4" Background="{DynamicResource CardBgBrush}"
                BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="130,120,90,100,80,80,100,Auto,*">
            <TextBlock Grid.Column="0" Text="委托·Ref" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="1" Text="合约" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="2" Text="方向" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="3" Text="价格" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="4" Text="数量" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="5" Text="已成" FontSize="12" FontWeight="SemiBold"/>
            <TextBlock Grid.Column="6" Text="状态" FontSize="12" FontWeight="SemiBold"/>
            <Button Grid.Column="7" Content="刷新" Command="{Binding RefreshOrdersCommand}" FontSize="11" Padding="8,2"/>
          </Grid>
        </Border>
        <ScrollViewer Grid.Row="1">
          <ItemsControl ItemsSource="{Binding Orders}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <Border Padding="10,3" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                  <Grid ColumnDefinitions="130,120,90,100,80,80,100,*">
                    <TextBlock Grid.Column="0" Text="{Binding Ref}" FontSize="12"/>
                    <TextBlock Grid.Column="1" Text="{Binding Instrument}" FontSize="12" FontWeight="SemiBold"/>
                    <TextBlock Grid.Column="2" Text="{Binding DirOffset}" FontSize="12"/>
                    <TextBlock Grid.Column="3" Text="{Binding Price, StringFormat=F2}" FontSize="12"/>
                    <TextBlock Grid.Column="4" Text="{Binding Volume}" FontSize="12"/>
                    <TextBlock Grid.Column="5" Text="{Binding Traded}" FontSize="12"/>
                    <TextBlock Grid.Column="6" Text="{Binding Status}" FontSize="12"/>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</UserControl>
