<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Aether.Desktop.Backtest.BacktestView">
  <!-- M3（规划中）：⑥ IBacktestRuntime + 策略选择/运行 -->
  <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="8">
    <TextBlock Text="回测" FontSize="20" FontWeight="SemiBold"
               Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
    <TextBlock Text="M3——⑥ IBacktestRuntime（LeanBacktestRunner）接线规划中"
               FontSize="13" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Center"/>
  </StackPanel>
</UserControl>
